{
  "name": "kura",
  "version": "0.2.0",
  "description": "Local knowledge management CLI backed by SQLite with hybrid RAG search",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kechol/kura"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build:client": "bun run scripts/build-html.ts",
    "build": "bun run build:client",
    "compile": "bun run scripts/compile.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit && bunx @biomejs/biome check src scripts tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13",
    "sqlite-vec": "0.1.9",
    "turndown": "7.2.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/d3-force": "3.0.10",
    "@types/turndown": "5.0.6",
    "d3-force": "3.0.0",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "lucide-preact": "1.45.0",
    "markdown-it": "15.0.2",
    "preact": "10.29.8",
    "typescript": "^7.0.2",
    "wouter-preact": "3.11.0"
  }
}
